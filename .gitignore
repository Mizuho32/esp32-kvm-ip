# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/

# mruby build-lockfile, auto-generated next to esp32s3_build_config.rb by
# rake (records the exact mruby version/release_no built) - not something
# to track, esp32-kvm-ip/components/mruby/mruby is already the pinned
# version via the submodule commit.
components/mruby/*.rb.lock
build/
build.*/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# Local WiFi credentials (see main/wifi_credentials.h.example)
main/wifi_credentials.h

# Local filter/conv rules (see main/filter_rules.h.example)
main/filter_rules.h

# Local route rules (see main/route_rules.h.example)
main/route_rules.h

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio
.vscode/
