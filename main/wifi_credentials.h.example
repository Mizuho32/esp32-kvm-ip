#ifndef WIFI_CREDENTIALS_H
#define WIFI_CREDENTIALS_H

// Copy this file to wifi_credentials.h and fill in KVM_TARGET_HOST.
// wifi_credentials.h is gitignored - unlike sdkconfig (Kconfig), editing
// it only triggers a recompile of the ~2 files that include it, not the
// whole project.
//
// WiFi SSID/password are NOT set here anymore - they're uploaded over
// serial to the wifi_cred flash partition instead
// (bin/upload_wifi_credentials.py), never as a compile-time constant, so
// real credentials never end up in the repo/build tree. See
// wifi_manager.h's wifi_manager_load_credentials().

// Host role only (KVM_ROLE=HOST): IP address or hostname of the
// Device-role esp32-kvm-ip board to forward captured USB HID input to.
#define KVM_TARGET_HOST "192.168.1.21"

#endif
