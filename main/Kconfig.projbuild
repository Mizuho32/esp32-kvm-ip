menu "USB HID Descriptor"

    config USB_DESC_MANUFACTURER
        string "Manufacturer"
        default "ESP32"
        help
            USB device manufacturer string.

    config USB_DESC_PRODUCT
        string "Product"
        default "Wireless KVM"
        help
            USB device product string.

    config USB_DESC_SERIAL
        string "Serial Number"
        default "000000000001"
        help
            USB device serial number string.

    config USB_DESC_VID
        hex "Vendor ID"
        default 0x303A
        help
            USB Vendor ID (0x303A = Espressif).

    config USB_DESC_PID
        hex "Product ID"
        default 0x4001
        help
            USB Product ID.

endmenu

menu "mruby filter/route (Host role)"

    config MRUBY_FILTER_ROUTE_ENABLE
        bool "Use mruby script for filter/conv/route instead of filter_rules.h/route_rules.h"
        default y
        help
            Host role (KVM_ROLE=HOST) only. When enabled, hid_forwarder.c
            calls into the embedded mruby script (main/mruby_scripts/default.rb)
            for filter/route decisions instead of the C filter_rules.h/
            route_rules.h path. If the script fails to load/parse at boot,
            it automatically falls back to the C path regardless of this
            setting - this only controls whether mruby is attempted at all.
            Also gates the WebUI (mruby_webui.c, Phase 2): with mruby
            itself compiled out there's nothing for it to edit, so it's a
            no-op in that case too.
            See mds/usb_hid/2026-08-28_mruby_filter_route.md and
            mds/usb_hid/2026-08-30_mruby_phase2_webui.md.

endmenu
