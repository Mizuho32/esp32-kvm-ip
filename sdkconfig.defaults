# Target: ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# 8MB flash (mds/usb_hid/2026-08-28_mruby_filter_route.md's target
# hardware) - custom partitions.csv gives the app partition 3MB, well
# above the default table's 1MB (mruby alone pushes the Host role image
# past 2MB) with headroom for growth and the Phase2 script-storage
# partition that design doc's next step will add.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 16384 (default 3584, previously bumped to 8192): app_main() (task
# "main") calls mruby_filter_init() on this task, and mruby's VM init +
# Prism parser overflowed the default stack on real hardware - see
# mds/usb_hid/2026-08-29_mruby_phase1_impl.md. 8192 was enough for that
# alone, but overflowed again once mruby_webui_start() (Phase 2,
# mds/usb_hid/2026-08-30_mruby_phase2_webui.md) - which also runs on
# this task and calls esp_http_server's httpd_start() - was added later
# in the same app_main() sequence. The overflow backtrace itself doesn't
# show the actual offending call site (ESP-IDF's stack-overflow
# detection unwinds the context-switch/panic path, not the corrupted
# task's own frames), so this is sized with headroom rather than tuned
# to an exact measurement. Only costs memory transiently during boot -
# task "main"'s stack is freed once app_main() returns.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# USB OTG (ESP32-S3 native USB) - Boot Keyboard + Boot Mouse + Consumer
# Control + System Control (Power Down/Sleep/Wake Up, see
# mds/usb_hid/2026-09-10_system_control_sleep.md)
CONFIG_TINYUSB_HID_COUNT=4

# Boards like Seeed XIAO ESP32S3 expose only a single USB-C port wired to
# the native USB pins (GPIO19/20). Once TinyUSB claims that port as the
# Boot Keyboard/Mouse device, it can no longer also serve as a USB-Serial-
# JTAG console. Route the console to UART0 instead (XIAO silkscreen D6/D7 =
# GPIO43/44 = default UART0 TX/RX) so logs stay available via an external
# USB-UART adapter. Flashing is unaffected - it uses the ROM bootloader's
# own download-mode driver on the same port, independent of this setting.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# Runtime per-task CPU stats (vTaskGetRunTimeStats()) - used to find
# what's starving usb_host_rp2040_bridge.c's bridge_task for tens of ms
# at a time (mds/usb_hid/2026-08-24_rp2040_bridge_fps_investigation.md). Trace
# facility is a prerequisite for the runtime-stats option.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# USB Host (Host role only, KVM_ROLE=HOST) - enables Hub-connected devices.
# Harmless when unused (Device role never installs the USB Host driver).
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# PSRAM (Seeed XIAO ESP32S3 uses an ESP32-S3R8 module - 8MB Octal PSRAM
# in-package, matching mds/usb_hid/2026-08-28_mruby_filter_route.md's
# "想定ハードウェア"). Added to fix an intermittent WebUI "out of memory"
# 500 that came from competing with mruby's VM heap/task stacks for the
# ~300-400K of internal SRAM alone - see
# mds/usb_hid/2026-08-30_mruby_phase2_webui.md.
#
# SPIRAM_USE_CAPS_ALLOC (not the default SPIRAM_USE_MALLOC) deliberately
# keeps plain malloc() internal-only - mruby's VM heap and the
# latency-sensitive mouse dispatch path (mds/usb_hid/2026-08-24_rp2040_bridge_fps_investigation.md)
# are untouched by this change. Only main/mruby_webui.c's own buffers
# explicitly opt in via heap_caps_malloc(..., MALLOC_CAP_SPIRAM).
#
# SPIRAM_IGNORE_NOTFOUND: if this assumption about the board's PSRAM is
# wrong (wrong module variant, or genuinely absent), boot proceeds
# without PSRAM instead of aborting - mruby_webui.c's heap_caps_malloc()
# calls then simply return NULL and fall back to regular malloc(), same
# behavior as before this change (see mruby_webui.c's webui_alloc()).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Bluetooth (Host role only, KVM_ROLE=HOST - ble_hid_device.c). NimBLE,
# not Bluedroid: ESP32-S3 has no Classic BT/BR-EDR anyway, and NimBLE is
# Espressif's own recommendation for BLE-only use cases to save memory -
# see mds/usb_hid/2026-09-07_ble_hid_sink_plan.md. Enabling this alone
# doesn't cost the Device role anything - the "bt"/"esp_hid" components
# only actually get linked in where main/CMakeLists.txt's HOST role
# PRIV_REQUIRES pulls them in (confirmed empirically: enabling these
# Kconfig options with nothing requiring the component produces an
# identical binary size to not enabling them at all).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# esp_hid's NimBLE HOGP backend (nimble_hidd.c) is entirely compiled out
# without this - defaults to n upstream since most NimBLE users don't
# need a HID *service* (as opposed to just BLE in general).
CONFIG_BT_NIMBLE_HID_SERVICE=y
# Must count every *report-mode* report ble_hid_device.c's combined
# report map declares (Boot-mode Keyboard/Mouse duplicates don't count -
# see nimble_hidd.c's create_hid_db(), which registers those via a
# separate always-on kbd_inp_present/mouse_inp_present flag instead of
# this counted array) - currently 4: keyboard, mouse, consumer, system
# control (mds/usb_hid/2026-09-10_system_control_sleep.md). Left at the
# default (3) after adding system control was a real bug found by
# reading create_hid_db() itself: reports beyond this count are silently
# dropped (`report_mode_rpts >= MAX_REPORTS` -> `break`, no error
# surfaced anywhere else) - see
# mds/usb_hid/2026-09-10_system_control_sleep.md's follow-up. Bump this
# again if another BLE report-mode kind is ever added.
CONFIG_BT_NIMBLE_SVC_HID_MAX_RPTS=4

# NimBLE's own host-stack logging (tag "NimBLE" - MODLOG_DFLT()/BLE_HS_LOG()
# calls sprinkled through the host source and esp_hid_gap.c's vendored GAP
# event handler alike) defaults to INFO, which prints a line for every
# single GATT notification sent ("notify_tx event"), every "GATT procedure
# initiated: ..." and low-level ATT ("att_...") exchange - i.e. once per
# HID report while BLE is in use. That's both console noise and (this
# project has already measured blocking UART console output as a real
# latency source on this exact hot path - see
# mds/usb_hid/2026-08-24_rp2040_bridge_fps_investigation.md) a likely
# contributor to BLE motion feeling laggier than type-c/UDP. Dropping to
# WARNING keeps real problems (encryption failures etc., which our own
# esp_hid_gap.c logs at ESP_LOGW under the separate "ESP_HID_GAP" tag -
# unaffected by this, since that's a plain esp_log tag/level, not
# NimBLE's own BT_NIMBLE_LOG_LEVEL) visible while silencing the routine
# per-report chatter.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Root cause of the reconnect-after-reset encryption-failure loop
# (mds/usb_hid/2026-09-07_ble_hid_sink_impl.md's follow-up:
# "encryption change event; status=7" / disconnect reason=517, looping
# forever on every reconnection attempt after any reset). Diagnosed via
# a temporary DEBUG-level NimBLE capture: on every failing attempt the
# host logs "looking up our sec; peer_addr=..." immediately followed by
# an HCI LE Long Term Key Request *Negative* Reply (ocf=0x001b) - i.e.
# ble_store_config (NimBLE's default bond store, wired up in
# ble_hid_device.c's ble_store_config_init() call) genuinely had no LTK
# on file for that peer. Root cause: BT_NIMBLE_NVS_PERSIST defaults to
# n, so that store is RAM-only and silently loses every bond on reset
# regardless of pairing method - which is also why bumping the nvs
# partition size and toggling sm_sc earlier both had zero effect: NVS
# was never actually being written to in the first place. Confirmed via
# grepping the DEBUG capture for "nvs_open_from_partition nimble_bond" -
# it never appeared once.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Trim NimBLE's internal-SRAM footprint to what this device actually uses.
# Real-hardware measurement (mds/usb_hid/2026-09-07_ble_hid_sink_impl.md's
# follow-up) found the largest contiguous internal-SRAM free block drops
# from 61440 bytes (BLE disabled) to as low as 17408 bytes just from
# ble_hid_device_start() running - *before* any PC ever connects - tight
# enough that the WebUI's syntax-check throwaway mrb_state (mruby_filter.c's
# mruby_filter_check_syntax(), a whole separate Prism parse+codegen pass)
# can fail with NoMemoryError. None of these settings were ever explicitly
# chosen before - they're all upstream NimBLE example/menuconfig defaults,
# sized generously for use cases this project doesn't have.
#
# - This device is BLE-peripheral-only: it advertises and accepts one
#   incoming connection from the target PC, and never scans, never
#   initiates its own outgoing connections, and never broadcasts anything
#   besides its own connectable advertisement. Central/Broadcaster/Observer
#   role support (all default y upstream) pulls in host-side state this
#   project's esp_hid_gap.c/ble_hid_device.c never call into.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# - Only one BLE central (the target PC) is ever connected at a time
#   (mds/usb_hid/2026-09-07_ble_hid_sink_plan.md's single-PC MVP) - the
#   upstream default of 3 reserves per-connection GATT/L2CAP/security
#   state for two connections this device can never actually use
#   simultaneously. Unrelated to CONFIG_BT_NIMBLE_MAX_BONDS (still 3,
#   above) - that one's about how many *bonds* are remembered across
#   reboots, not simultaneous live connections, and multiple PCs bonding
#   in turn already works fine without raising this.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# - CCCDs (a peer's per-characteristic notify/indicate subscription state)
#   are persisted across reboots in a *global* fixed-size table shared by
#   every bonded peer combined (BLE_STORE_MAX_CCCDS - see
#   ble_store_config.c's ble_store_config_write_cccd(), and note this is
#   unrelated to CONFIG_BT_NIMBLE_MAX_BONDS above, which only caps how
#   many *peers'* keys/identities are remembered). This device exposes 6
#   Input Report characteristics needing a CCCD each (keyboard/mouse ×
#   boot+report mode, Consumer Control, System Control) - one bonded peer
#   alone is already most of the upstream default of 8. Once
#   ble_pair_slots.c (mds/usb_hid/2026-09-12_ble_multi_pair.md) started
#   keeping up to BLE_PAIR_SLOT_COUNT (3) bonds around simultaneously
#   instead of clearing the store on every new pairing, that table filled
#   up for real on real hardware: ble_store_config_write_cccd() returning
#   BLE_HS_ESTORE_CAP mid-subscribe made the *ATT write itself* fail (its
#   return value is what ble_gatts_clt_cfg_access() sends back to the
#   peer as the CCCD write's result, not just a "couldn't persist this"
#   side note) - the peer's OS gave up on that characteristic's (and
#   apparently every later one's) notifications entirely, silently
#   breaking all HID input. 3 slots × 6 CCCDs = 18; rounded up with
#   headroom for a device or two re-pairing into the same slot without
#   immediately evicting the old entry.
CONFIG_BT_NIMBLE_MAX_CCCDS=24

# - HID reports here are tiny (<=8 bytes - see ble_hid_device.h's report
#   layouts, well under the 20-byte usable payload a bare 23-byte ATT_MTU
#   already gives a notification) - no characteristic this device exposes
#   needs anywhere near the upstream default 256-byte preferred MTU, which
#   reserves a 256-byte buffer per direction per connection. 23
#   (BLE_ATT_MTU_DFLT, confirmed in nimble's ble_att.c as the actual
#   protocol-mandated floor ble_att_set_preferred_mtu() enforces) means no
#   MTU exchange is even needed.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23

# - "Prepare Write"/"Execute Write" queuing is only ever used for
#   characteristic writes longer than one ATT MTU - nothing in this HID
#   service's report characteristics is ever written by the peer at all
#   (Input Report, notify-only), so the upstream default of 64 queued
#   prepare-write entries is pure dead weight here.
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=1

# - Unused example GATT profile services this project's HOGP device never
#   declares or references: Proximity, Alert Notification, Current Time,
#   Health Thermometer, Internet Protocol Support, Tx Power, Immediate
#   Alert, Link Loss, Heart Rate. Left enabled: GAP/BAS/DIS/SPS - despite
#   its name, "Serial Port Service" (SPS) has nothing to do with this
#   project's own serial console; esp_hid's NimBLE backend
#   (components/esp_hid/src/nimble_hidd.c) unconditionally calls
#   ble_svc_gap_init()/_bas_init()/_dis_init()/_sps_init() itself (a build
#   error - "undefined reference to ble_svc_sps_init" - is what caught
#   this dependency), so all four (plus HID itself) have to stay on
#   regardless of whether this project's own code ever touches them.
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n

# WiFi OTA (mruby_webui.c's POST /api/firmware, ota_updater.c,
# mds/usb_hid/2026-09-10_wifi_ota.md). partitions.csv uses a two-slot
# ota_0/ota_1 scheme (no factory) - this makes the bootloader mark a
# freshly-flashed OTA image "pending verify" on its first boot and
# automatically revert to the previous slot if that first boot never
# calls esp_ota_mark_app_valid_cancel_rollback() (crash, watchdog reset,
# or power loss before the app confirms itself) - see
# ota_updater.c's app_main()-time call to that function.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Crash safety net (mds/usb_hid/2026-09-13_crash_reporting.md) - see
# main/crash_report.c. ESP_COREDUMP_ENABLE_TO_FLASH writes a full ELF
# coredump (registers/backtrace/task list) to the `coredump` partition
# (partitions.csv) on panic/watchdog reset; auto-selects
# ESP_COREDUMP_DATA_FORMAT_ELF and ESP_COREDUMP_CHECKSUM_SHA256, no need
# to set those separately. crash_report.c reads it back at the next boot
# via esp_core_dump_get_panic_reason()/get_summary(), saves a short
# human-readable summary into NVS (survives any number of further clean
# reboots - the coredump partition itself is left alone, not erased,
# since ESP-IDF overwrites it with the next crash by default anyway, and
# the raw ELF is still handy for a deeper offline look), and surfaces the
# NVS summary in the WebUI + an optional ntfy.sh push.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Heap tracing (esp_heap_trace.h) - kept off by default (HEAP_TRACING_OFF)
# normally, since even just compiling it in costs a bit of IRAM and a
# small malloc/free CPU overhead project-wide. Turned on here so
# mruby_filter.c's `heap_trace_start`/`heap_trace_dump` DSL commands
# (main/crash_report.c) are available for on-demand leak hunts like
# mds/usb_hid/2026-09-13_ble_idle_crash.md's - STANDALONE (not
# HOST-based/JTAG) since this board is never attached to a debugger in
# normal use.
CONFIG_HEAP_TRACING_STANDALONE=y

# 16 (default 10) - real-hardware finding
# (mds/usb_hid/2026-09-13_crash_reporting.md's follow-up):
# esp_http_client's crash_notify_test/notify_task (ntfy.sh push) failed
# outright with "esp-tls: Failed to create socket" - not a TLS problem,
# a plain lwIP socket() exhaustion. mruby_webui.c's httpd server alone
# reserves 7 of the previous 10 via HTTPD_DEFAULT_CONFIG()'s
# max_open_sockets (3 of those 7 are httpd's own fixed internal
# overhead, per esp_http_server.h's own doc comment - only 4 are ever
# available for actual client connections), leaving just 3 for
# hid_forwarder.c's UDP socket, debug_stream.c's own separate httpd
# instance, DNS/NTP lookups, and now this outbound HTTPS client all at
# once. Raising the ceiling (a small fixed per-socket cost paid once at
# boot, not a leak - unlike everything mds/usb_hid/2026-09-13_ble_idle_crash.md
# chased) is simpler and cheaper than trimming the WebUI's own budget,
# which risked making the WebUI itself flaky under concurrent tabs/the
# debug stream's long-lived connection instead.
CONFIG_LWIP_MAX_SOCKETS=16
